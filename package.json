{
  "name": "otterbot",
  "version": "2.0.0",
  "private": true,
  "description": "Personal AI assistant with persistent cross-session learning",
  "license": "MIT",
  "scripts": {
    "build": "pnpm -r build",
    "start": "node packages/server/dist/index.js",
    "predev": "node scripts/ensure-env.mjs",
    "dev": "pnpm --filter @otterbot/shared build && { pnpm --filter @otterbot/shared dev & pnpm --filter @otterbot/server dev & pnpm --filter @otterbot/web dev; }",
    "dev:server": "pnpm --filter @otterbot/server dev",
    "dev:web": "pnpm --filter @otterbot/web dev",
    "dev:cli": "pnpm --filter @otterbot/cli dev",
    "dev:daemon": "node scripts/dev-daemon.mjs",
    "cli": "pnpm --filter @otterbot/cli start",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @otterbot/web test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "typescript": "^5.7.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3-multiple-ciphers",
      "esbuild",
      "onnxruntime-node"
    ]
  },
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  }
}
