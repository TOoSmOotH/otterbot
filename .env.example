# otterbot — multi-agent server configuration.
#
# This file holds GLOBAL/server settings. Each agent additionally has its own
# isolated `.env` inside its profile directory (data/profiles/<id>/.env) for
# per-agent secrets — API keys, GitHub token, SMTP credentials, model endpoints.

# ── Server ───────────────────────────────────────────────────────────
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info

# Where profile directories, control.db and agent databases live.
DATA_DIR=./data

# ── Default local model endpoint ─────────────────────────────────────
# Used as the fallback for agents on the `lmstudio` provider that do not
# override LMSTUDIO_BASE_URL in their own profile .env. Any OpenAI-compatible
# server works (LM Studio, Ollama at /v1, vLLM, …).
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_API_KEY=lm-studio
LMSTUDIO_MODEL=local-model

# ── Cloud provider keys (optional, global fallback) ──────────────────
# Preferred location is each agent's own profile .env, but these work as a
# fallback for every agent on that provider.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# ── Agent-to-agent transport ─────────────────────────────────────────
# "local" (default) keeps agent-to-agent messages in-process.
# "discord" routes them through a shared Discord channel.
AGENT_TRANSPORT=local
# DISCORD_BOT_TOKEN=
# DISCORD_CHANNEL_ID=

# ── Optional virtual desktop (noVNC) ─────────────────────────────────
ENABLE_DESKTOP=false
VNC_HOST=127.0.0.1
VNC_PORT=5901
