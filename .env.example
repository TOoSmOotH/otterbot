# otterbot — server configuration.
#
# Credentials (per-agent API keys, GitHub tokens, SMTP, model endpoints) are
# NOT kept here — they live in the encrypted database and are managed through
# the Agent Studio UI. The ONLY secret in this file is the database key below.

# ── Database encryption key ──────────────────────────────────────────
# Encrypts every SQLite database (control DB + per-agent DBs), including all
# stored credentials. Set this to a long random string and keep it safe — if
# lost, the databases cannot be opened. If unset, databases are UNENCRYPTED
# (local dev only).
OTTERBOT_DB_KEY=change-me-to-a-long-random-string

# ── Server (non-secret) ──────────────────────────────────────────────
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info
DATA_DIR=./data
WEB_DIST_DIR=./packages/web/dist

# ── Default local model endpoint (non-secret) ────────────────────────
# Fallback for agents on the `lmstudio` provider. Any OpenAI-compatible
# server works (LM Studio, Ollama at /v1, vLLM). Per-agent overrides are
# set in the Agent Studio.
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_MODEL=local-model

# ── Agent-to-agent transport ─────────────────────────────────────────
AGENT_TRANSPORT=local
# DISCORD_BOT_TOKEN / DISCORD_CHANNEL_ID — set only if AGENT_TRANSPORT=discord
# DISCORD_BOT_TOKEN=
# DISCORD_CHANNEL_ID=
